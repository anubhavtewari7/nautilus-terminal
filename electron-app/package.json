{
  "name": "nautilus-terminal",
  "version": "1.0.0",
  "description": "NAUTILUS Terminal — Supply Chain Intelligence Desktop App",
  "main": "main.js",
  "author": "Anubhav Tewari",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-packager . \"NAUTILUS Terminal\" --platform=win32 --arch=x64 --out=dist --overwrite --app-version=1.0.0",
    "build:mac": "electron-packager . \"NAUTILUS Terminal\" --platform=darwin --arch=x64 --out=dist --overwrite --app-version=1.0.0"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-packager": "^17.1.2"
  }
}
